# Copy to an untracked .env.production file and replace every placeholder.
ENVIRONMENT=production
POSTGRES_PASSWORD=<replace-with-a-long-random-postgres-password>
DATABASE_URL=postgresql+psycopg://atm:<replace-with-a-long-random-postgres-password>@db:5432/atm_cash
JWT_SECRET_KEY=<replace-with-a-long-random-jwt-secret-at-least-32-characters>
BOOTSTRAP_ADMIN_USERNAME=<replace-with-a-unique-admin-username>
BOOTSTRAP_ADMIN_PASSWORD=<replace-with-a-long-random-admin-password>
CORS_ORIGINS=https://<your-deployed-frontend-origin>
ASYNC_NOTIFICATIONS=false
